---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contribute"
  description="Share a PC game result tested on modest hardware with Potato Approved."
>
  <header class="page-heading">
    <p class="eyebrow">COMMUNITY TESTS</p>
    <h1>Contribute</h1>
    <p>Tested a game on modest hardware? Share your results and help grow Potato Approved.</p>
  </header>

  <div class="contribute-layout">
    <aside class="contribution-guide" aria-labelledby="useful-information">
      <p class="eyebrow">BEFORE YOU SEND</p>
      <h2 id="useful-information">Useful information</h2>
      <p>The most helpful results include:</p>
      <ul>
        <li>GPU / iGPU</li>
        <li>Resolution</li>
        <li>Graphics settings</li>
        <li>Performance</li>
        <li>Any important issues</li>
      </ul>
      <p class="review-note">
        Submissions are reviewed manually and are not published automatically. Information may be corrected or clarified before publication.
      </p>
    </aside>

    <section class="contribution-panel" aria-labelledby="contribution-form-heading">
      <h2 id="contribution-form-heading">Share your result</h2>
      <p class="required-note"><span aria-hidden="true">*</span> Required fields</p>

      <form
        id="contribution-form"
        class="contribution-form"
        action="https://formspree.io/f/xnpnlpzq"
        method="POST"
      >
        <div class="form-grid">
          <div class="form-field form-field-full">
            <label for="game-title">Game title <span aria-hidden="true">*</span></label>
            <input id="game-title" name="game_title" type="text" autocomplete="off" required data-fs-field />
          </div>

          <div class="form-field">
            <label for="suggested-category">Suggested category <span aria-hidden="true">*</span></label>
            <select id="suggested-category" name="suggested_category" required data-fs-field>
              <option value="">Choose a category</option>
              <option value="Potato Approved">Potato Approved</option>
              <option value="Fries Approved">Fries Approved</option>
              <option value="Not sure">Not sure</option>
            </select>
          </div>

          <div class="form-field">
            <label for="gpu">GPU / iGPU <span aria-hidden="true">*</span></label>
            <input id="gpu" name="gpu" type="text" autocomplete="off" required data-fs-field />
          </div>

          <div class="form-field">
            <label for="cpu">CPU</label>
            <input id="cpu" name="cpu" type="text" autocomplete="off" data-fs-field />
          </div>

          <div class="form-field">
            <label for="ram">RAM</label>
            <input id="ram" name="ram" type="text" autocomplete="off" data-fs-field />
          </div>

          <div class="form-field">
            <label for="resolution">Resolution</label>
            <select id="resolution" name="resolution" data-fs-field>
              <option value="">Choose a resolution</option>
              <option value="720p">720p</option>
              <option value="900p">900p</option>
              <option value="1080p">1080p</option>
              <option value="1440p">1440p</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div class="form-field">
            <label for="graphics-settings">Graphics settings</label>
            <select id="graphics-settings" name="graphics_settings" data-fs-field>
              <option value="">Choose settings</option>
              <option value="Very Low">Very Low</option>
              <option value="Low">Low</option>
              <option value="Medium">Medium</option>
              <option value="High">High</option>
              <option value="Custom">Custom</option>
            </select>
          </div>

          <div class="form-field form-field-full">
            <label for="performance">Performance <span aria-hidden="true">*</span></label>
            <input id="performance" name="performance" type="text" placeholder="45-60 FPS" autocomplete="off" required data-fs-field />
          </div>

          <div class="form-field form-field-full">
            <label for="experience">Experience <span aria-hidden="true">*</span></label>
            <textarea
              id="experience"
              name="experience"
              required
              aria-describedby="experience-help"
              data-fs-field
            ></textarea>
            <p class="field-help" id="experience-help">
              How playable did the game feel? Mention important frame drops, stutters, or other problems.
            </p>
          </div>

          <div class="form-field form-field-full">
            <label for="contributor-email">Contributor email</label>
            <input
              id="contributor-email"
              name="email"
              type="email"
              autocomplete="email"
              aria-describedby="email-help"
              data-fs-field
            />
            <p class="field-help" id="email-help">Only used if clarification is needed.</p>
          </div>
        </div>

        <div class="form-honeypot" aria-hidden="true">
          <label for="website">Leave this field empty</label>
          <input id="website" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <label class="confirmation-field" for="personal-test">
          <input id="personal-test" name="personally_tested" type="checkbox" value="Yes" required data-fs-field />
          <span>I personally tested this game on the hardware described above.</span>
        </label>

        <div class="form-actions">
          <button class="submit-button" type="submit" data-fs-submit-btn>Send contribution</button>
          <p class="form-status" data-form-status aria-live="polite" role="status"></p>
        </div>
      </form>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  window.formspree = window.formspree || function () {
    (window.formspree.q = window.formspree.q || []).push(arguments);
  };

  const fallbackError = 'Something went wrong. Please try again.';

  function getErrorMessage(error) {
    if (typeof error === 'string' && error.trim()) return error;
    if (!error || typeof error !== 'object') return fallbackError;

    if (typeof error.message === 'string' && error.message.trim()) {
      return error.message;
    }

    if (typeof error.getFormErrors === 'function') {
      const messages = error.getFormErrors()
        .map((item) => typeof item === 'string' ? item : item?.message)
        .filter(Boolean);
      if (messages.length) return messages.join(' ');
    }

    if (Array.isArray(error.errors)) {
      const messages = error.errors
        .map((item) => typeof item === 'string' ? item : item?.message)
        .filter(Boolean);
      if (messages.length) return messages.join(' ');
    }

    return fallbackError;
  }

  function setFormStatus(form, state, message) {
    const status = form.querySelector('[data-form-status]');
    if (!status) return;

    status.dataset.state = state;
    status.textContent = message;
  }

  window.formspree('initForm', {
    formElement: '#contribution-form',
    formId: 'xnpnlpzq',
    disable: ({ form }) => {
      const button = form.querySelector('[data-fs-submit-btn]');
      if (button) {
        button.disabled = true;
        button.textContent = 'Sending...';
      }
      setFormStatus(form, '', '');
    },
    enable: ({ form }) => {
      const button = form.querySelector('[data-fs-submit-btn]');
      if (button) {
        button.disabled = false;
        button.textContent = 'Send contribution';
      }
    },
    renderSuccess: ({ form }) => {
      form.reset();
      setFormStatus(form, 'success', 'Thanks for contributing! Your result has been sent for review.');
    },
    renderFormError: ({ form }, error) => {
      setFormStatus(form, 'error', getErrorMessage(error));
    },
    renderFieldErrors: ({ form }, error) => {
      setFormStatus(form, 'error', getErrorMessage(error));
    },
  });
</script>
<script is:inline src="https://unpkg.com/@formspree/ajax@1" defer></script>
