---
import type { CollectionEntry } from 'astro:content';
import GameCard from './GameCard.astro';

interface Props {
  initialGames: CollectionEntry<'games'>[];
  allGames: CollectionEntry<'games'>[];
  category: 'potato' | 'fries';
}

const { initialGames, allGames, category } = Astro.props;
const categoryLabel = category === 'potato' ? 'Potato Approved' : 'Fries Approved';
const sortedInitialGames = [...initialGames].sort((a, b) => a.data.title.localeCompare(b.data.title));
const searchData = [...allGames]
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
  .map(({ data }) => data);
const serializedSearchData = JSON.stringify(searchData).replaceAll('<', '\\u003c');
---

<section class="catalogue" data-game-list>
  <div class="search-wrap">
    <label for="game-search">Search the whole catalogue</label>
    <input
      id="game-search"
      type="search"
      placeholder="Title, genre, year, hardware…"
      autocomplete="off"
      data-game-search
    />
    <p class="search-help" data-search-help>
      Showing {categoryLabel} games. Start typing to search both categories.
    </p>
  </div>

  <p class="result-count" aria-live="polite" data-result-count hidden></p>

  <div class="game-list" data-game-results>
    {sortedInitialGames.map(({ data }) => <GameCard game={data} />)}
  </div>

  <p class="empty-state" data-empty-state hidden>No games found.</p>
  <script type="application/json" data-game-data set:html={serializedSearchData}></script>
</section>

<script>
  import '../scripts/game-search.js';
</script>
